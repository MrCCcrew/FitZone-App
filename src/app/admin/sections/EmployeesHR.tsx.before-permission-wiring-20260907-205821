function dateInputValue(value: string | null | undefined) {
  if (!value) return "";
  return value.slice(0, 10);
}

async function readJson(response: Response) {
  return response.json().catch(() => ({}));
}

export default function EmployeesHR() {
  const [activeTab, setActiveTab] = useState<
    "employees" | "catalogs" | "trainer-links" | "attendance"
  >("employees");
  const [employees, setEmployees] = useState<Employee[]>([]);
  const [departments, setDepartments] = useState<Department[]>([]);
  const [positions, setPositions] = useState<Position[]>([]);

  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);

  const [error, setError] = useState<string | null>(null);
  const [message, setMessage] = useState<string | null>(null);

  const [search, setSearch] = useState("");
  const [status, setStatus] = useState("");
  const [departmentId, setDepartmentId] = useState("");
  const [positionId, setPositionId] = useState("");

  const [form, setForm] = useState<EmployeeForm | null>(null);
  const [catalogForm, setCatalogForm] = useState<CatalogForm | null>(null);
  const [trainerLinks, setTrainerLinks] = useState<TrainerLinkRow[]>([]);
  const [trainerLinkForm, setTrainerLinkForm] =
    useState<TrainerLinkForm | null>(null);
  const [unlinkTrainerId, setUnlinkTrainerId] = useState<string | null>(null);
  const [unlinkReason, setUnlinkReason] = useState("");
  const [attendanceRows, setAttendanceRows] = useState<EmployeeAttendanceRow[]>(
    [],
  );
  const [attendancePeriod, setAttendancePeriod] =
    useState<AttendancePeriodState | null>(null);

  const [attendanceMonth, setAttendanceMonth] = useState(cairoMonthKey);
  const [attendanceEmployeeId, setAttendanceEmployeeId] = useState("");
  const [attendanceStatus, setAttendanceStatus] = useState("");

  const [attendanceForm, setAttendanceForm] = useState<AttendanceForm | null>(
    null,
  );

  const [unlockAttendanceOpen, setUnlockAttendanceOpen] = useState(false);
  const [unlockAttendanceReason, setUnlockAttendanceReason] = useState("");

  const activeDepartments = useMemo(
    () => departments.filter((item) => item.isActive),
    [departments],
  );

  const activePositions = useMemo(
    () => positions.filter((item) => item.isActive),
    [positions],
  );

  const loadCatalogs = useCallback(async () => {
    const [departmentResponse, positionResponse] = await Promise.all([
      fetch("/api/admin/departments", { cache: "no-store" }),
      fetch("/api/admin/positions", { cache: "no-store" }),
    ]);

    const departmentPayload = await readJson(departmentResponse);
    const positionPayload = await readJson(positionResponse);

    if (!departmentResponse.ok) {
      throw new Error(departmentPayload.error || "تعذر تحميل الأقسام.");
    }

    if (!positionResponse.ok) {
      throw new Error(positionPayload.error || "تعذر تحميل المسميات الوظيفية.");
    }

    setDepartments(
      Array.isArray(departmentPayload.departments)
        ? departmentPayload.departments
        : [],
    );

    setPositions(
      Array.isArray(positionPayload.positions) ? positionPayload.positions : [],
    );
  }, []);

  const loadAttendance = useCallback(async () => {
    const params = new URLSearchParams();

    if (attendanceMonth) {
      params.set("month", attendanceMonth);
    }

    if (attendanceEmployeeId) {
      params.set("employeeId", attendanceEmployeeId);
    }

    if (attendanceStatus) {
      params.set("status", attendanceStatus);
    }

    const response = await fetch(
      `/api/admin/employee-attendance?${params.toString()}`,
      { cache: "no-store" },
    );

    const payload = await readJson(response);

    if (!response.ok) {
      throw new Error(payload.error || "تعذر تحميل الحضور العام.");
    }

    setAttendanceRows(Array.isArray(payload.rows) ? payload.rows : []);

    setAttendancePeriod(
      payload.period ?? {
        monthKey: attendanceMonth || null,
        status: "open",
        implicit: true,
      },
    );
  }, [attendanceMonth, attendanceEmployeeId, attendanceStatus]);

  const loadTrainerLinks = useCallback(async () => {
    const response = await fetch("/api/admin/employees/trainer-link", {
      cache: "no-store",
    });

    const payload = await readJson(response);

    if (!response.ok) {
      throw new Error(payload.error || "تعذر تحميل روابط المدربين.");
    }

    setTrainerLinks(Array.isArray(payload.trainers) ? payload.trainers : []);
  }, []);

  const loadEmployees = useCallback(async () => {
    const params = new URLSearchParams();

    if (search.trim()) {
      params.set("search", search.trim());
    }

    if (status) {
      params.set("status", status);
    }

    if (departmentId) {
      params.set("departmentId", departmentId);
    }

    if (positionId) {
      params.set("positionId", positionId);
    }

    const response = await fetch(`/api/admin/employees?${params.toString()}`, {
      cache: "no-store",
    });

    const payload = await readJson(response);

    if (!response.ok) {
      throw new Error(payload.error || "تعذر تحميل الموظفين.");
    }

    setEmployees(Array.isArray(payload.employees) ? payload.employees : []);
  }, [search, status, departmentId, positionId]);

  const reload = useCallback(async () => {
    setLoading(true);
    setError(null);

    try {
      await Promise.all([loadCatalogs(), loadEmployees(), loadTrainerLinks()]);
    } catch (loadError) {
      setError(
        loadError instanceof Error
          ? loadError.message
          : "تعذر تحميل بيانات الموارد البشرية.",
      );
    } finally {
      setLoading(false);
    }
  }, [loadCatalogs, loadEmployees, loadTrainerLinks]);

  useEffect(() => {
    void reload();
  }, [reload]);

  const openCreate = () => {
    setError(null);
    setMessage(null);
    setForm({ ...EMPTY_FORM });
  };

  const openEdit = (employee: Employee) => {
    setError(null);
    setMessage(null);

    setForm({
      id: employee.id,

      employeeCode: employee.employeeCode,
      name: employee.name,
      phone: employee.phone ?? "",
      avatar: employee.avatar ?? "",

      departmentId: employee.departmentId ?? "",
      positionId: employee.positionId ?? "",

      hireDate: dateInputValue(employee.hireDate),
      employmentEndDate: dateInputValue(employee.employmentEndDate),
      employmentStatus: employee.employmentStatus,
      payrollEnabled: employee.payrollEnabled,
      notes: employee.notes ?? "",
    });
  };

  const saveEmployee = async () => {
    if (!form) return;

    if (!form.name.trim()) {
      setError("اسم الموظف مطلوب.");
      return;
    }

    if (!form.id && !form.employeeCode.trim()) {
      setError("كود الموظف مطلوب.");
      return;
    }

    setSaving(true);
    setError(null);
    setMessage(null);

    try {
      const isEdit = Boolean(form.id);

      const body: Record<string, unknown> = {
        name: form.name.trim(),
        phone: form.phone.trim() || null,
        avatar: form.avatar.trim() || null,

        departmentId: form.departmentId || null,
        positionId: form.positionId || null,

        hireDate: form.hireDate || null,
        employmentEndDate: form.employmentEndDate || null,

        employmentStatus: form.employmentStatus,
        payrollEnabled: form.payrollEnabled,
        notes: form.notes.trim() || null,
      };

      if (isEdit) {
        body.id = form.id;
      } else {
        body.employeeCode = form.employeeCode.trim();
      }

      const response = await fetch("/api/admin/employees", {
        method: isEdit ? "PATCH" : "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(body),
      });

      const payload = await readJson(response);

      if (!response.ok) {
        throw new Error(
          payload.error ||
            (isEdit ? "تعذر تحديث ملف الموظف." : "تعذر إنشاء ملف الموظف."),
        );
      }

      setForm(null);
      setMessage(isEdit ? "تم تحديث ملف الموظف." : "تم إنشاء ملف الموظف.");

      await loadEmployees();
    } catch (saveError) {
      setError(
        saveError instanceof Error ? saveError.message : "تعذر حفظ ملف الموظف.",
      );
    } finally {
      setSaving(false);
    }
  };

  useEffect(() => {
    if (activeTab !== "attendance") return;

    void loadAttendance().catch((loadError) => {
      setError(
        loadError instanceof Error
          ? loadError.message
          : "تعذر تحميل الحضور العام.",
      );
    });
  }, [activeTab, loadAttendance]);

  const openAttendanceCreate = () => {
    setError(null);
    setMessage(null);

    setAttendanceForm({
      employeeId: attendanceEmployeeId,
      date: attendanceMonth ? `${attendanceMonth}-01` : "",
      status: "present",
      scheduledStartTime: "",
      scheduledEndTime: "",
      checkInAt: "",
      checkOutAt: "",
      lateMinutes: "0",
      notes: "",
      editReason: "",
    });
  };

  const openAttendanceEdit = (row: EmployeeAttendanceRow) => {
    setError(null);
    setMessage(null);

    setAttendanceForm({
      existingId: row.id,
      employeeId: row.employeeId,
      date: row.attendanceDate.slice(0, 10),
      status: row.status,
      scheduledStartTime: row.scheduledStartTime ?? "",
      scheduledEndTime: row.scheduledEndTime ?? "",
      checkInAt: dateTimeLocalValue(row.checkInAt),
      checkOutAt: dateTimeLocalValue(row.checkOutAt),
      lateMinutes: String(row.lateMinutes ?? 0),
      notes: row.notes ?? "",
      editReason: "",
    });
  };

  const saveAttendance = async () => {
    if (!attendanceForm) return;

    if (!attendanceForm.employeeId) {
      setError("الموظف مطلوب.");
      return;
    }

    if (!attendanceForm.date) {
      setError("التاريخ مطلوب.");
      return;
    }

    if (
      attendanceForm.existingId &&
      attendanceForm.editReason.trim().length < 3
    ) {
      setError("سبب تعديل سجل الحضور مطلوب، 3 أحرف على الأقل.");
      return;
    }

    const lateMinutes = Number(attendanceForm.lateMinutes || "0");

    if (!Number.isInteger(lateMinutes) || lateMinutes < 0) {
      setError("دقائق التأخير يجب أن تكون رقمًا صحيحًا موجبًا أو صفرًا.");
      return;
    }

    setSaving(true);
    setError(null);
    setMessage(null);

    try {
      const response = await fetch("/api/admin/employee-attendance", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          employeeId: attendanceForm.employeeId,
          date: attendanceForm.date,
          status: attendanceForm.status,
          scheduledStartTime: attendanceForm.scheduledStartTime || null,
          scheduledEndTime: attendanceForm.scheduledEndTime || null,
          checkInAt: attendanceForm.checkInAt
            ? cairoLocalDateTimeToIso(attendanceForm.checkInAt)
            : null,
          checkOutAt: attendanceForm.checkOutAt
            ? cairoLocalDateTimeToIso(attendanceForm.checkOutAt)
            : null,
          lateMinutes,
          notes: attendanceForm.notes.trim() || null,
          editReason: attendanceForm.existingId
            ? attendanceForm.editReason.trim()
            : null,
        }),
      });

      const payload = await readJson(response);

      if (!response.ok) {
        throw new Error(payload.error || "تعذر حفظ الحضور.");
      }

      setAttendanceForm(null);

      setMessage(
        attendanceForm.existingId ? "تم تعديل سجل الحضور." : "تم تسجيل الحضور.",
      );

      await loadAttendance();
    } catch (attendanceError) {
      setError(
        attendanceError instanceof Error
          ? attendanceError.message
          : "تعذر حفظ الحضور.",
      );
    } finally {
      setSaving(false);
    }
  };

  const lockAttendanceMonth = async () => {
    if (!attendanceMonth) {
      setError("اختر الشهر أولًا.");
      return;
    }

    setSaving(true);
    setError(null);
    setMessage(null);

    try {
      const response = await fetch(
        "/api/admin/employee-attendance/period/lock",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            monthKey: attendanceMonth,
          }),
        },
      );

      const payload = await readJson(response);

      if (!response.ok) {
        throw new Error(payload.error || "تعذر قفل شهر الحضور.");
      }

      setMessage("تم قفل شهر الحضور.");
      await loadAttendance();
    } catch (lockError) {
      setError(
        lockError instanceof Error ? lockError.message : "تعذر قفل شهر الحضور.",
      );
    } finally {
      setSaving(false);
    }
  };

  const unlockAttendanceMonth = async () => {
    if (!attendanceMonth) {
      setError("اختر الشهر أولًا.");
      return;
    }

    if (unlockAttendanceReason.trim().length < 3) {
      setError("سبب فك القفل مطلوب، 3 أحرف على الأقل.");
      return;
    }

    setSaving(true);
    setError(null);
    setMessage(null);

    try {
      const response = await fetch(
        "/api/admin/employee-attendance/period/unlock",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            monthKey: attendanceMonth,
            reason: unlockAttendanceReason.trim(),
          }),
        },
      );

      const payload = await readJson(response);

      if (!response.ok) {
        throw new Error(payload.error || "تعذر فك قفل شهر الحضور.");
      }

      setUnlockAttendanceOpen(false);
      setUnlockAttendanceReason("");
      setMessage("تم فك قفل شهر الحضور.");

      await loadAttendance();
    } catch (unlockError) {
      setError(
        unlockError instanceof Error
          ? unlockError.message
          : "تعذر فك قفل شهر الحضور.",
      );
    } finally {
      setSaving(false);
    }
  };

  const openTrainerLink = (trainer: TrainerLinkRow) => {
    setError(null);
    setMessage(null);

    setTrainerLinkForm({
      trainerId: trainer.id,
      employeeId: trainer.employeeId ?? "",
    });
  };

  const saveTrainerLink = async () => {
    if (!trainerLinkForm) return;

    if (!trainerLinkForm.employeeId) {
      setError("اختر الموظف المطلوب ربطه.");
      return;
    }

    setSaving(true);
    setError(null);
    setMessage(null);

    try {
      const response = await fetch("/api/admin/employees/trainer-link", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          trainerId: trainerLinkForm.trainerId,
          employeeId: trainerLinkForm.employeeId,
        }),
      });

      const payload = await readJson(response);

      if (!response.ok) {
        throw new Error(payload.error || "تعذر ربط المدرب بالموظف.");
      }

      setTrainerLinkForm(null);
      setMessage("تم حفظ ربط المدرب بالموظف.");

      await loadTrainerLinks();
