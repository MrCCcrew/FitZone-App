function minorToMoneyInput(value: number) {
  return (value / 100).toFixed(2);
}

function bpsToPercentInput(value: number) {
  return (value / 100).toString();
}

function formatMoneyMinor(value: number, currency = "EGP") {
  return `${(value / 100).toLocaleString("ar-EG", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  })} ${currency === "EGP" ? "ج.م" : currency}`;
}

function formatBps(value: number) {
  return `${(value / 100).toLocaleString("ar-EG", {
    maximumFractionDigits: 2,
  })}%`;
}

function parseMoneyToMinor(value: string) {
  const trimmed = value.trim();

  if (!/^\d+(?:\.\d{1,2})?$/.test(trimmed)) {
    throw new Error("أدخل مبلغًا صحيحًا بحد أقصى منزلتين عشريتين.");
  }

  const amount = Number(trimmed);
  const minor = Math.round(amount * 100);

  if (!Number.isSafeInteger(minor) || minor < 0) {
    throw new Error("قيمة المبلغ غير صالحة.");
  }

  return minor;
}

function parsePercentToBps(value: string) {
  const trimmed = value.trim();

  if (!/^\d+(?:\.\d{1,2})?$/.test(trimmed)) {
    throw new Error("أدخل نسبة صحيحة بحد أقصى منزلتين عشريتين.");
  }

  const percent = Number(trimmed);

  if (percent < 0 || percent > 100) {
    throw new Error("النسبة يجب أن تكون بين 0% و100%.");
  }

  return Math.round(percent * 100);
}

