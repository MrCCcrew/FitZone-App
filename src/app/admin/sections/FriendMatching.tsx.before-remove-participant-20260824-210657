"use client";

import { useCallback, useEffect, useState } from "react";
import {
  AdminCard,
  AdminEmptyState,
  AdminSectionShell,
} from "./shared";

type ParticipantRow = {
  id: string;
  userId: string;
  role: string;
  status: string;
  shareAmountMinor: number;
  paidAt: string | null;
  joinedAt: string;
  paymentTransactionId: string | null;
  user: {
    id: string;
    name: string | null;
    email: string | null;
    phone: string | null;
  };
  payment: {
    id: string;
    status: string;
    amount: number;
    provider: string;
    createdAt: string;
  } | null;
};

type MatchingGroup = {
  id: string;
  token: string;
  status: string;
  matchingEnabled: boolean;
  createdAt: string;
  expiresAt: string;
  isTimeExpired: boolean;
  hasEconomicCommitment: boolean;
  priceSnapshotMinor: number;
  offer: {
    id: string;
    title: string;
    titleEn: string | null;
  };
  creator: {
    id: string;
    name: string | null;
    email: string | null;
    phone: string | null;
  };
  requiredMembers: number;
  joinedCount: number;
  remainingPlaces: number;
  paidCount: number;
  participants: ParticipantRow[];
};

function statusLabel(status: string) {
  const labels: Record<string, string> = {
    waiting: "بانتظار شريكة",
    ready: "اكتمل العدد",
    finalizing: "جارٍ التفعيل",
    completed: "مكتمل",
    expired: "منتهي",
    cancelled: "ملغي",
    joined: "انضمت",
    checkout_started: "بدأت الدفع",
    paid: "دفعت",
    activated: "تم التفعيل",
  };

  return labels[status] ?? status;
}

function paymentLabel(status?: string | null) {
  if (!status) return "لم تبدأ الدفع";

  const labels: Record<string, string> = {
    pending: "قيد الدفع",
    requires_action: "بانتظار إتمام الدفع",
    paid: "مدفوع",
    failed: "فشل",
    cancelled: "ملغي",
    expired: "منتهي",
    refunded: "مسترد",
  };

  return labels[status] ?? status;
}

function formatMoney(minor: number) {
  return `${(minor / 100).toLocaleString("ar-EG", {
    minimumFractionDigits: 0,
    maximumFractionDigits: 2,
  })} ج.م`;
}

function formatDate(value: string) {
  const date = new Date(value);

  return date.toLocaleString("ar-EG", {
    timeZone: "Africa/Cairo",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
  });
}

export default function FriendMatching() {
  const [groups, setGroups] = useState<MatchingGroup[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [matchGroup, setMatchGroup] = useState<MatchingGroup | null>(null);
  const [search, setSearch] = useState("");
  const [candidates, setCandidates] = useState<
    Array<{
      id: string;
      name: string | null;
      email: string | null;
      phone: string | null;
    }>
  >([]);
  const [searching, setSearching] = useState(false);
  const [matching, setMatching] = useState(false);
  const [matchError, setMatchError] = useState<string | null>(null);

  const loadData = useCallback(async () => {
    setLoading(true);
    setError(null);

    try {
      const response = await fetch("/api/admin/friend-offers/matching", {
        cache: "no-store",
      });

      const payload = (await response.json().catch(() => ({}))) as {
        groups?: MatchingGroup[];
        error?: string;
      };

      if (!response.ok) {
        throw new Error(payload.error || "تعذر تحميل الطلبات.");
      }

      setGroups(Array.isArray(payload.groups) ? payload.groups : []);
    } catch (loadError) {
      setError(
        loadError instanceof Error
          ? loadError.message
          : "تعذر تحميل الطلبات.",
      );
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    void loadData();
  }, [loadData]);

  useEffect(() => {
    if (!matchGroup || search.trim().length < 2) {
      setCandidates([]);
      return;
    }

    let cancelled = false;

    const timer = window.setTimeout(async () => {
      setSearching(true);
      setMatchError(null);

      try {
        const response = await fetch(
          `/api/admin/friend-offers/matching?mode=candidates&search=${encodeURIComponent(search.trim())}`,
          { cache: "no-store" },
        );

        const payload = (await response.json().catch(() => ({}))) as {
          users?: Array<{
            id: string;
            name: string | null;
            email: string | null;
            phone: string | null;
          }>;
          error?: string;
        };

        if (!response.ok) {
          throw new Error(payload.error || "تعذر البحث عن العميلات.");
        }

        if (!cancelled) {
          setCandidates(Array.isArray(payload.users) ? payload.users : []);
        }
      } catch (searchError) {
        if (!cancelled) {
          setMatchError(
            searchError instanceof Error
              ? searchError.message
              : "تعذر البحث عن العميلات.",
          );
        }
      } finally {
        if (!cancelled) setSearching(false);
      }
    }, 350);

    return () => {
      cancelled = true;
      window.clearTimeout(timer);
    };
  }, [matchGroup, search]);

  const matchCandidate = async (userId: string) => {
    if (!matchGroup || matching) return;

    setMatching(true);
    setMatchError(null);

    try {
      const response = await fetch("/api/admin/friend-offers/matching", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          groupId: matchGroup.id,
          userId,
        }),
      });

      const payload = (await response.json().catch(() => ({}))) as {
        success?: boolean;
        error?: string;
      };

      if (!response.ok || !payload.success) {
        throw new Error(payload.error || "تعذر تنفيذ المطابقة.");
      }

      setMatchGroup(null);
      setSearch("");
      setCandidates([]);
      await loadData();
    } catch (matchFailure) {
      setMatchError(
        matchFailure instanceof Error
          ? matchFailure.message
          : "تعذر تنفيذ المطابقة.",
      );
    } finally {
      setMatching(false);
    }
  };

  return (
    <AdminSectionShell
      title="طلبات عرض الصحاب"
      subtitle="طلبات العميلات اللاتي اخترن أن يبحث الجيم لهن عن شريكة، مع مطابقة آمنة بدون نقل أو دمج أي عمليات دفع."
    >
      <div className="mb-5 flex items-center justify-between gap-3">
        <div className="text-sm text-[#d7aabd]">
          إجمالي الطلبات:{" "}
          <span className="font-black text-white">{groups.length}</span>
        </div>

        <button
          type="button"
          onClick={() => void loadData()}
          disabled={loading}
          className="rounded-xl border border-pink-400/20 bg-pink-500/10 px-4 py-2 text-sm font-bold text-pink-100 transition hover:bg-pink-500/20 disabled:opacity-50"
        >
          {loading ? "جارٍ التحديث..." : "تحديث"}
        </button>
      </div>

      {error ? (
        <AdminCard>
          <div className="rounded-xl border border-red-400/20 bg-red-500/10 p-4 text-sm text-red-200">
            {error}
          </div>
        </AdminCard>
      ) : null}

      {!loading && !error && groups.length === 0 ? (
        <AdminEmptyState
          title="لا توجد طلبات مطابقة حاليًا"
          description="عندما تختار عميلة «ابحثي لي عن شريكة» سيظهر طلبها هنا."
        />
      ) : null}

      <div className="space-y-4">
        {groups.map((group) => (
          <AdminCard key={group.id}>
            <div className="space-y-5">
              <div className="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <div className="text-lg font-black text-[#fff4f8]">
                    {group.offer.title}
                  </div>

                  <div className="mt-1 text-sm text-[#d7aabd]">
                    صاحبة الطلب:{" "}
                    <span className="font-bold text-white">
                      {group.creator.name || "بدون اسم"}
                    </span>
                  </div>

                  <div className="mt-1 text-xs text-[#b98a9e]">
                    {group.creator.phone ||
                      group.creator.email ||
                      "لا توجد وسيلة اتصال"}
                  </div>
                </div>

                <div className="rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-xs font-bold text-white">
                  {statusLabel(group.status)}
                </div>
              </div>

              <div className="grid gap-3 sm:grid-cols-2 xl:grid-cols-5">
                <div className="rounded-xl bg-white/5 p-3">
                  <div className="text-xs text-[#b98a9e]">إجمالي المجموعة</div>
                  <div className="mt-1 font-black text-white">
                    {formatMoney(group.priceSnapshotMinor)}
                  </div>
                </div>

                <div className="rounded-xl bg-white/5 p-3">
                  <div className="text-xs text-[#b98a9e]">المطلوب</div>
                  <div className="mt-1 font-black text-white">
                    {group.requiredMembers}
                  </div>
                </div>

                <div className="rounded-xl bg-white/5 p-3">
                  <div className="text-xs text-[#b98a9e]">انضموا</div>
                  <div className="mt-1 font-black text-white">
                    {group.joinedCount}
                  </div>
                </div>

                <div className="rounded-xl bg-white/5 p-3">
                  <div className="text-xs text-[#b98a9e]">المتبقي</div>
                  <div className="mt-1 font-black text-white">
                    {group.remainingPlaces}
                  </div>
                </div>

                <div className="rounded-xl bg-white/5 p-3">
                  <div className="text-xs text-[#b98a9e]">دفعوا</div>
                  <div className="mt-1 font-black text-white">
                    {group.paidCount}
                  </div>
                </div>
              </div>

              <div className="grid gap-2 text-xs text-[#d7aabd] md:grid-cols-2">
                <div>
                  وقت الطلب:{" "}
                  <span className="text-white">
                    {formatDate(group.createdAt)}
                  </span>
                </div>

                <div>
                  انتهاء الطلب:{" "}
                  <span
                    className={
                      group.isTimeExpired
                        ? "font-bold text-red-300"
                        : "text-white"
                    }
                  >
                    {formatDate(group.expiresAt)}
                  </span>
                </div>
              </div>

              {group.remainingPlaces > 0 &&
              group.status !== "cancelled" &&
              group.status !== "completed" &&
              group.status !== "finalizing" ? (
                <div>
                  <button
                    type="button"
                    onClick={() => {
                      setMatchGroup(group);
                      setSearch("");
                      setCandidates([]);
                      setMatchError(null);
                    }}
                    className="rounded-xl bg-pink-600 px-4 py-2 text-sm font-black text-white transition hover:bg-pink-500"
                  >
                    اختيار شريكة
                  </button>
                </div>
              ) : null}

              {group.hasEconomicCommitment ? (
                <div className="rounded-xl border border-amber-400/20 bg-amber-500/10 px-4 py-3 text-xs font-bold text-amber-100">
                  توجد دفعة فعلية داخل هذه المجموعة — لا يجوز نقل المشاركات أو
                  دمج المجموعة يدويًا.
                </div>
              ) : null}

              <div className="overflow-x-auto">
                <table className="w-full min-w-[760px] text-right text-sm">
                  <thead>
                    <tr className="border-b border-white/10 text-xs text-[#b98a9e]">
                      <th className="px-3 py-3">العميلة</th>
                      <th className="px-3 py-3">الدور</th>
                      <th className="px-3 py-3">الحالة</th>
                      <th className="px-3 py-3">الحصة</th>
                      <th className="px-3 py-3">الدفع</th>
                      <th className="px-3 py-3">وقت الانضمام</th>
                    </tr>
                  </thead>

                  <tbody>
                    {group.participants.map((participant) => (
                      <tr
                        key={participant.id}
                        className="border-b border-white/5 text-[#fff4f8]"
                      >
                        <td className="px-3 py-3">
                          <div className="font-bold">
                            {participant.user.name || "بدون اسم"}
                          </div>
                          <div className="mt-1 text-xs text-[#b98a9e]">
                            {participant.user.phone ||
                              participant.user.email ||
                              "—"}
                          </div>
                        </td>

                        <td className="px-3 py-3">
                          {participant.role === "creator"
                            ? "صاحبة الطلب"
                            : "شريكة"}
                        </td>

                        <td className="px-3 py-3">
                          {statusLabel(participant.status)}
                        </td>

                        <td className="px-3 py-3 font-black">
                          {formatMoney(participant.shareAmountMinor)}
                        </td>

                        <td className="px-3 py-3">
                          {paymentLabel(participant.payment?.status)}
                        </td>

                        <td className="px-3 py-3 text-xs">
                          {formatDate(participant.joinedAt)}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </AdminCard>
        ))}
      </div>

      {matchGroup ? (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4">
          <button
            type="button"
            aria-label="إغلاق"
            className="absolute inset-0 bg-black/70"
            onClick={() => {
              if (!matching) setMatchGroup(null);
            }}
          />

          <div className="relative z-10 w-full max-w-xl rounded-[26px] border border-pink-300/15 bg-[#32101f] p-6 shadow-2xl">
            <div className="flex items-start justify-between gap-4">
              <div>
                <h3 className="text-lg font-black text-white">
                  اختيار شريكة
                </h3>
                <p className="mt-1 text-sm text-[#d7aabd]">
                  {matchGroup.offer.title}
                </p>
              </div>

              <button
                type="button"
                disabled={matching}
                onClick={() => setMatchGroup(null)}
                className="text-2xl text-[#d7aabd] hover:text-white disabled:opacity-50"
              >
                ×
              </button>
            </div>

            <input
              autoFocus
              value={search}
              onChange={(event) => setSearch(event.target.value)}
              placeholder="ابحثي بالاسم أو البريد أو الهاتف..."
              className="mt-5 w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white outline-none focus:border-pink-400"
            />

            {searching ? (
              <div className="mt-4 text-sm text-[#d7aabd]">
                جارٍ البحث...
              </div>
            ) : null}

            {matchError ? (
              <div className="mt-4 rounded-xl border border-red-400/20 bg-red-500/10 p-3 text-sm text-red-200">
                {matchError}
              </div>
            ) : null}

            <div className="mt-4 max-h-[360px] space-y-2 overflow-y-auto">
              {!searching &&
              search.trim().length >= 2 &&
              candidates.length === 0 ? (
                <div className="rounded-xl bg-white/5 p-4 text-sm text-[#d7aabd]">
                  لا توجد عميلة مطابقة للبحث.
                </div>
              ) : null}

              {candidates
                .filter(
                  (candidate) =>
                    !matchGroup.participants.some(
                      (participant) =>
                        participant.userId === candidate.id &&
                        participant.status !== "cancelled",
                    ),
                )
                .map((candidate) => (
                  <div
                    key={candidate.id}
                    className="flex items-center justify-between gap-3 rounded-xl border border-white/10 bg-white/5 p-3"
                  >
                    <div className="min-w-0">
                      <div className="font-bold text-white">
                        {candidate.name || "بدون اسم"}
                      </div>
                      <div className="mt-1 truncate text-xs text-[#b98a9e]">
                        {candidate.phone ||
                          candidate.email ||
                          "لا توجد وسيلة اتصال"}
                      </div>
                    </div>

                    <button
                      type="button"
                      disabled={matching}
                      onClick={() => void matchCandidate(candidate.id)}
                      className="shrink-0 rounded-lg bg-pink-600 px-3 py-2 text-xs font-black text-white hover:bg-pink-500 disabled:opacity-50"
                    >
                      {matching ? "جارٍ..." : "مطابقة"}
                    </button>
                  </div>
                ))}
            </div>
          </div>
        </div>
      ) : null}
    </AdminSectionShell>
  );
}
