"use client";

import { useCallback, useEffect, useState } from "react";
import {
  AdminCard,
  AdminEmptyState,
  AdminSectionShell,
} from "./shared";

type ParticipantRow = {
  id: string;
  userId: string;
  role: string;
  status: string;
  shareAmountMinor: number;
  paidAt: string | null;
  joinedAt: string;
  paymentTransactionId: string | null;
  user: {
    id: string;
    name: string | null;
    email: string | null;
    phone: string | null;
  };
  payment: {
    id: string;
    status: string;
    amount: number;
    provider: string;
    createdAt: string;
  } | null;
};

type MatchingGroup = {
  id: string;
  token: string;
  status: string;
  matchingEnabled: boolean;
  createdAt: string;
  expiresAt: string;
  isTimeExpired: boolean;
  hasEconomicCommitment: boolean;
  priceSnapshotMinor: number;
  offer: {
    id: string;
    title: string;
    titleEn: string | null;
  };
  creator: {
    id: string;
    name: string | null;
    email: string | null;
    phone: string | null;
  };
  requiredMembers: number;
  joinedCount: number;
  remainingPlaces: number;
  paidCount: number;
  participants: ParticipantRow[];
};

function statusLabel(status: string) {
  const labels: Record<string, string> = {
    waiting: "بانتظار شريكة",
    ready: "اكتمل العدد",
    finalizing: "جارٍ التفعيل",
    completed: "مكتمل",
    expired: "منتهي",
    cancelled: "ملغي",
    joined: "انضمت",
    checkout_started: "بدأت الدفع",
    paid: "دفعت",
    activated: "تم التفعيل",
  };

  return labels[status] ?? status;
}

function paymentLabel(status?: string | null) {
  if (!status) return "لم تبدأ الدفع";

  const labels: Record<string, string> = {
    pending: "قيد الدفع",
    requires_action: "بانتظار إتمام الدفع",
    paid: "مدفوع",
    failed: "فشل",
    cancelled: "ملغي",
    expired: "منتهي",
    refunded: "مسترد",
  };

  return labels[status] ?? status;
}

function formatMoney(minor: number) {
  return `${(minor / 100).toLocaleString("ar-EG", {
    minimumFractionDigits: 0,
    maximumFractionDigits: 2,
  })} ج.م`;
}

function formatDate(value: string) {
  const date = new Date(value);

  return date.toLocaleString("ar-EG", {
    timeZone: "Africa/Cairo",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
  });
}

export default function FriendMatching() {
  const [groups, setGroups] = useState<MatchingGroup[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const loadData = useCallback(async () => {
    setLoading(true);
    setError(null);

    try {
      const response = await fetch("/api/admin/friend-offers/matching", {
        cache: "no-store",
      });

      const payload = (await response.json().catch(() => ({}))) as {
        groups?: MatchingGroup[];
        error?: string;
      };

      if (!response.ok) {
        throw new Error(payload.error || "تعذر تحميل الطلبات.");
      }

      setGroups(Array.isArray(payload.groups) ? payload.groups : []);
    } catch (loadError) {
      setError(
        loadError instanceof Error
          ? loadError.message
          : "تعذر تحميل الطلبات.",
      );
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    void loadData();
  }, [loadData]);

  return (
    <AdminSectionShell
      title="طلبات عرض الصحاب"
      subtitle="طلبات العميلات اللاتي اخترن أن يبحث الجيم لهن عن شريكة. العرض هنا للمتابعة فقط ولا ينفذ أي تعديل."
    >
      <div className="mb-5 flex items-center justify-between gap-3">
        <div className="text-sm text-[#d7aabd]">
          إجمالي الطلبات:{" "}
          <span className="font-black text-white">{groups.length}</span>
        </div>

        <button
          type="button"
          onClick={() => void loadData()}
          disabled={loading}
          className="rounded-xl border border-pink-400/20 bg-pink-500/10 px-4 py-2 text-sm font-bold text-pink-100 transition hover:bg-pink-500/20 disabled:opacity-50"
        >
          {loading ? "جارٍ التحديث..." : "تحديث"}
        </button>
      </div>

      {error ? (
        <AdminCard>
          <div className="rounded-xl border border-red-400/20 bg-red-500/10 p-4 text-sm text-red-200">
            {error}
          </div>
        </AdminCard>
      ) : null}

      {!loading && !error && groups.length === 0 ? (
        <AdminEmptyState
          title="لا توجد طلبات مطابقة حاليًا"
          description="عندما تختار عميلة «ابحثي لي عن شريكة» سيظهر طلبها هنا."
        />
      ) : null}

      <div className="space-y-4">
        {groups.map((group) => (
          <AdminCard key={group.id}>
            <div className="space-y-5">
              <div className="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <div className="text-lg font-black text-[#fff4f8]">
                    {group.offer.title}
                  </div>

                  <div className="mt-1 text-sm text-[#d7aabd]">
                    صاحبة الطلب:{" "}
                    <span className="font-bold text-white">
                      {group.creator.name || "بدون اسم"}
                    </span>
                  </div>

                  <div className="mt-1 text-xs text-[#b98a9e]">
                    {group.creator.phone ||
                      group.creator.email ||
                      "لا توجد وسيلة اتصال"}
                  </div>
                </div>

                <div className="rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-xs font-bold text-white">
                  {statusLabel(group.status)}
                </div>
              </div>

              <div className="grid gap-3 sm:grid-cols-2 xl:grid-cols-5">
                <div className="rounded-xl bg-white/5 p-3">
                  <div className="text-xs text-[#b98a9e]">إجمالي المجموعة</div>
                  <div className="mt-1 font-black text-white">
                    {formatMoney(group.priceSnapshotMinor)}
                  </div>
                </div>

                <div className="rounded-xl bg-white/5 p-3">
                  <div className="text-xs text-[#b98a9e]">المطلوب</div>
                  <div className="mt-1 font-black text-white">
                    {group.requiredMembers}
                  </div>
                </div>

                <div className="rounded-xl bg-white/5 p-3">
                  <div className="text-xs text-[#b98a9e]">انضموا</div>
                  <div className="mt-1 font-black text-white">
                    {group.joinedCount}
                  </div>
                </div>

                <div className="rounded-xl bg-white/5 p-3">
                  <div className="text-xs text-[#b98a9e]">المتبقي</div>
                  <div className="mt-1 font-black text-white">
                    {group.remainingPlaces}
                  </div>
                </div>

                <div className="rounded-xl bg-white/5 p-3">
                  <div className="text-xs text-[#b98a9e]">دفعوا</div>
                  <div className="mt-1 font-black text-white">
                    {group.paidCount}
                  </div>
                </div>
              </div>

              <div className="grid gap-2 text-xs text-[#d7aabd] md:grid-cols-2">
                <div>
                  وقت الطلب:{" "}
                  <span className="text-white">
                    {formatDate(group.createdAt)}
                  </span>
                </div>

                <div>
                  انتهاء الطلب:{" "}
                  <span
                    className={
                      group.isTimeExpired
                        ? "font-bold text-red-300"
                        : "text-white"
                    }
                  >
                    {formatDate(group.expiresAt)}
                  </span>
                </div>
              </div>

              {group.hasEconomicCommitment ? (
                <div className="rounded-xl border border-amber-400/20 bg-amber-500/10 px-4 py-3 text-xs font-bold text-amber-100">
                  توجد دفعة فعلية داخل هذه المجموعة — لا يجوز نقل المشاركات أو
                  دمج المجموعة يدويًا.
                </div>
              ) : null}

              <div className="overflow-x-auto">
                <table className="w-full min-w-[760px] text-right text-sm">
                  <thead>
                    <tr className="border-b border-white/10 text-xs text-[#b98a9e]">
                      <th className="px-3 py-3">العميلة</th>
                      <th className="px-3 py-3">الدور</th>
                      <th className="px-3 py-3">الحالة</th>
                      <th className="px-3 py-3">الحصة</th>
                      <th className="px-3 py-3">الدفع</th>
                      <th className="px-3 py-3">وقت الانضمام</th>
                    </tr>
                  </thead>

                  <tbody>
                    {group.participants.map((participant) => (
                      <tr
                        key={participant.id}
                        className="border-b border-white/5 text-[#fff4f8]"
                      >
                        <td className="px-3 py-3">
                          <div className="font-bold">
                            {participant.user.name || "بدون اسم"}
                          </div>
                          <div className="mt-1 text-xs text-[#b98a9e]">
                            {participant.user.phone ||
                              participant.user.email ||
                              "—"}
                          </div>
                        </td>

                        <td className="px-3 py-3">
                          {participant.role === "creator"
                            ? "صاحبة الطلب"
                            : "شريكة"}
                        </td>

                        <td className="px-3 py-3">
                          {statusLabel(participant.status)}
                        </td>

                        <td className="px-3 py-3 font-black">
                          {formatMoney(participant.shareAmountMinor)}
                        </td>

                        <td className="px-3 py-3">
                          {paymentLabel(participant.payment?.status)}
                        </td>

                        <td className="px-3 py-3 text-xs">
                          {formatDate(participant.joinedAt)}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </AdminCard>
        ))}
      </div>
    </AdminSectionShell>
  );
}
