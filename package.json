{
  "name": "fitzone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:test": "node scripts/build-test-isolated.mjs",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:seed-admin": "npx tsx prisma/seed-admin.ts",
    "analytics:retention": "npx tsx scripts/analytics-retention.ts",
    "backfill:offer-classes": "npx tsx scripts/backfill-offer-classes.ts",
    "check:encoding": "node scripts/check-text-encoding.mjs",
    "cleanup:test-data": "node scripts/cleanup-test-data.mjs --dry-run",
    "cleanup:test-data:confirm": "node scripts/cleanup-test-data.mjs --confirm",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:load": "node tests/load/homepage.mjs && node tests/load/public-api.mjs && node tests/load/store.mjs",
    "test:load:home": "node tests/load/homepage.mjs",
    "test:load:public": "node tests/load/public-api.mjs",
    "test:load:store": "node tests/load/store.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1018.0",
    "@prisma/adapter-mariadb": "^6.19.2",
    "@prisma/client": "^6.19.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.27",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.6",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.577.0",
    "mariadb": "^3.5.2",
    "next": "^16.1.6",
    "nodemailer": "^7.0.7",
    "pdfkit": "^0.18.0",
    "prisma": "^6.19.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.9",
    "autocannon": "^8.0.0",
    "vitest": "^4.1.9"
  },
  "browserslist": {
    "production": [
      "chrome >= 93",
      "firefox >= 92",
      "safari >= 15",
      "edge >= 93",
      "not dead",
      ">0.3%"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
