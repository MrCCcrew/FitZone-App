generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Auth (NextAuth v5) ───────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  phone         String?
  gender        String?   // single_graduated | married_new | married_with_kids | student
  birthDate     DateTime?
  governorate   String?
  address       String?
  password      String?
  role          String    @default("member") // member | trainer | staff | admin
  jobTitle      String?
  adminAccess   Boolean   @default(false)
  adminPermissions String? @db.LongText // JSON array of AdminFeature keys
  isActive      Boolean   @default(true)
  discountType  String    @default("fixed") // fixed | percentage
  discountValue Float     @default(0)
  maxDiscount   Float?
  commissionRate Float    @default(0)
  commissionType String   @default("percentage") // percentage | fixed
  avatar        String?
  pendingApproval   Boolean   @default(false) // set true when trainer creates a customer pending admin/head_coach approval
  pendingPartnerRef String? // affiliate link token stored at registration, cleared after first paid subscription
  pendingAgentRef   String? // sales agent referral code stored at registration, cleared after first paid subscription
  pendingStaffRef    String? // staff referral link token stored at registration, cleared after first paid subscription
  pendingTrainerRef  String? // trainer referral link token stored at registration, cleared after first paid subscription
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // App relations
  memberships   UserMembership[]
  bookings      Booking[]
  orders        Order[]
  paymentTransactions PaymentTransaction[]
  wallet        Wallet?
  rewardPoints  RewardPoints?
  referral      Referral?
  notifications Notification[]
  complaints    Complaint[]
  testimonials  Testimonial[]
  productReviews ProductReview[]
  handledChatSessions ChatSession[]  @relation("AssignedSupport")
  supportPresence     SupportPresence?
  auditLogs           AuditLog[]     @relation("AuditActor")
  coachProfile        CoachProfile?
  pushSubscriptions   PushSubscription[]
  pushCampaigns       PushCampaign[]     @relation("CampaignAdmin")
  trainerProfile             Trainer?                    @relation("TrainerAccount")
  trainerDiscountCodesTarget TrainerDiscountCode[]        @relation("TrainerCodeTarget")
  staffDiscountCodesIssued   StaffDiscountCode[]          @relation("StaffCodeIssuer")
  staffDiscountCodesTarget   StaffDiscountCode[]          @relation("StaffCodeTarget")
  attributedMemberships      UserMembership[]             @relation("MembershipSalesAgent")
  agentCommissions           AgentCommission[]            @relation("AgentCommissionUser")
  partnerProfile             Partner?                    @relation("PartnerAccount")
  privateApplications        PrivateSessionApplication[] @relation("PrivateApplicationUser")
  attendancePasses           AttendancePass[]
  attendanceCheckIns         AttendanceCheckIn[]         @relation("AttendanceMember")
  scannedAttendanceCheckIns  AttendanceCheckIn[]         @relation("AttendanceScannedBy")
  salesAgent                 SalesAgent?
  salesAgentReferral         SalesAgentReferral?
  contractsManager           ContractsManager?
  recordedAttendanceLogs     TrainerAttendanceLog[]      @relation("AttendanceRecorder")
  staffReferralLinks         StaffReferralLink[]         @relation("StaffLinks")
  staffCommissions           StaffCommission[]           @relation("StaffCommissions")
  trainerReferralLinks       TrainerReferralLink[]       @relation("TrainerLinks")
  trainerCommissions         TrainerCommission[]         @relation("TrainerCommissions")
  healthResponses            HealthResponse[]            @relation("HealthResponses")
  nutritionistProfile        NutritionistProfile?        @relation("NutritionistAccount")
  nutritionSessions          NutritionSession[]          @relation("NutritionSessionUser")
  orderStatusHistory         OrderStatusHistory[]        @relation("OrderStatusPerformer")
  inventoryMovementsPerformed InventoryMovement[]        @relation("InventoryMovementPerformer")
  inventoryReceiptsPerformed  InventoryReceipt[]         @relation("InventoryReceiptPerformer")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorName   String?
  actorEmail  String?
  actorRole   String?
  action      String
  targetType  String
  targetId    String?
  details     String?  @db.LongText
  ipAddress   String?
  userAgent   String?  @db.Text
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([targetType, createdAt])
}

// ─── Membership ───────────────────────────────────────────────────────────────

model Membership {
  id          String  @id @default(cuid())
  name        String
  nameEn      String?
  kind        String  @default("subscription") // subscription | package
  price       Float
  priceBefore Float?
  priceAfter  Float?
  image       String?
  sortOrder   Int     @default(0)
  duration    Int     // days
  cycle       String? // monthly | quarterly | semi_annual | annual | custom
  sessionsCount Int?  // عدد الحصص للاشتراك
  features    String  @db.Text // JSON array stored as string
  featuresEn  String? @db.Text
  classSessions String? @db.LongText // JSON: class-specific sessions
  productRewards String? @db.LongText // JSON: product benefits for packages
  maxClasses  Int     @default(-1) // -1 = unlimited
  minMonths   Int?    // for custom kind: minimum selectable months
  maxMonths   Int?    // for custom kind: maximum selectable months
  discountPct Float?  // for custom kind: discount percentage (e.g. 50 = 50%)
  walletBonus Float   @default(0)
  gift        String?
  giftEn      String?
  subtitle    String? @db.Text
  isFeatured  Boolean @default(false)
  isActive    Boolean @default(true)

  userMemberships  UserMembership[]
  recommendedFor   ChatSession[]
  offers           Offer[]
  goals            MembershipGoal[]
}

model UserMembership {
  id           String   @id @default(cuid())
  userId       String
  membershipId String
  startDate    DateTime @default(now())
  endDate      DateTime
  status       String   @default("active") // active | expired | cancelled
  paymentAmount Float   @default(0)
  paymentMethod String? // cash | free | wallet | card | instapay | offer
  offerTitle    String?
  offerId       String?
  totalSessions Int?
  productRewardsUsed String? @db.LongText
  salesAgentUserId String?
  salesCodeType    String?

  partnerId       String?
  partnerCodeId   String?
  affiliateLinkId String?
  salesAgentId    String?  // SalesAgent.id if subscribed via agent referral link
  staffReferralLinkId   String? // StaffReferralLink.id if subscribed via staff referral link
  trainerReferralLinkId String? // TrainerReferralLink.id if subscribed via trainer referral link

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership    Membership            @relation(fields: [membershipId], references: [id])
  offer         Offer?                @relation(fields: [offerId], references: [id], onDelete: SetNull)
  salesAgent    User?                 @relation("MembershipSalesAgent", fields: [salesAgentUserId], references: [id], onDelete: SetNull)
  partner       Partner?              @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  partnerCode   PartnerCode?          @relation(fields: [partnerCodeId], references: [id], onDelete: SetNull)
  affiliateLink PartnerAffiliateLink? @relation(fields: [affiliateLinkId], references: [id], onDelete: SetNull)
  refAgent      SalesAgent?           @relation(fields: [salesAgentId], references: [id], onDelete: SetNull)
  staffReferralLink   StaffReferralLink?   @relation(fields: [staffReferralLinkId], references: [id], onDelete: SetNull)
  trainerReferralLink TrainerReferralLink? @relation(fields: [trainerReferralLinkId], references: [id], onDelete: SetNull)
  bookings      Booking[]
  attendancePass      AttendancePass?
  attendanceCheckIns  AttendanceCheckIn[]
  partnerCommission   PartnerCommission?
  agentCommission     AgentCommission?
  salesAgentCommission SalesAgentCommission?
  staffCommission      StaffCommission?
  trainerCommission    TrainerCommission?

  @@index([partnerId])
  @@index([salesAgentUserId])
  @@index([salesAgentId])
}

model AttendancePass {
  id                          String   @id @default(cuid())
  userId                      String
  userMembershipId            String?  @unique
  privateSessionApplicationId String?  @unique
  code                        String   @unique
  kind                        String   // membership | private_session
  status                      String   @default("active") // active | inactive | revoked | expired
  label                       String?
  lastUsedAt                  DateTime?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userMembership            UserMembership?            @relation(fields: [userMembershipId], references: [id], onDelete: SetNull)
  privateSessionApplication PrivateSessionApplication? @relation(fields: [privateSessionApplicationId], references: [id], onDelete: SetNull)
  checkIns                  AttendanceCheckIn[]

  @@index([userId, status])
}

model AttendanceCheckIn {
  id                          String   @id @default(cuid())
  passId                      String
  userId                      String
  userMembershipId            String?
  privateSessionApplicationId String?
  bookingId                   String?  @unique
  scheduleId                  String?
  scannedByUserId             String?
  checkInType                 String   // class | private | mini_private
  notes                       String?  @db.Text
  createdAt                   DateTime @default(now())

  pass                      AttendancePass              @relation(fields: [passId], references: [id], onDelete: Cascade)
  user                      User                        @relation("AttendanceMember", fields: [userId], references: [id], onDelete: Cascade)
  userMembership            UserMembership?             @relation(fields: [userMembershipId], references: [id], onDelete: SetNull)
  privateSessionApplication PrivateSessionApplication?  @relation(fields: [privateSessionApplicationId], references: [id], onDelete: SetNull)
  booking                   Booking?                    @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  scannedBy                 User?                       @relation("AttendanceScannedBy", fields: [scannedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([scheduleId, createdAt])
  @@index([scannedByUserId, createdAt])
}

// ─── Trainer ──────────────────────────────────────────────────────────────────

model Trainer {
  id             String  @id @default(cuid())
  userId         String? @unique
  name           String
  nameEn         String?
  specialty      String
  specialtyEn    String?
  bio            String?
  bioEn          String? @db.Text
  certifications String? @db.Text // JSON array
  certificationsEn String? @db.Text // JSON array
  certificateFiles String? @db.LongText // JSON array of image URLs
  rating         Float   @default(5.0)
  sessionsCount  Int     @default(0)
  image          String?
  isActive          Boolean @default(true)
  showOnHome        Boolean @default(true)
  sortOrder         Int     @default(0)
  canSendGifts      Boolean @default(false)
  giftMonthlyLimit  Int     @default(4)
  canAddClasses     Boolean @default(false)
  canAddBookings    Boolean @default(false)

  user                  User?                      @relation("TrainerAccount", fields: [userId], references: [id], onDelete: SetNull)
  classes               Class[]
  discountCodes         TrainerDiscountCode[]
  privateApplications   PrivateSessionApplication[]
  attendanceLogs        TrainerAttendanceLog[]
}

model TrainerAttendanceLog {
  id           String    @id @default(cuid())
  trainerId    String
  date         DateTime  @db.Date
  status       String    // present | absent | late
  notes        String?   @db.Text
  recordedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  trainer    Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([trainerId, date])
  @@index([trainerId, date])
  @@index([date])
}

// ─── Class ────────────────────────────────────────────────────────────────────

model Class {
  id          String  @id @default(cuid())
  name        String
  nameEn      String?
  description String?
  descriptionEn String? @db.Text
  trainerId   String
  category    String? // القسم الرئيسي
  categoryEn  String?
  type        String  // cardio | strength | yoga | boxing | swimming | dance
  typeEn      String?
  subType     String? // التصنيف الفرعي
  subTypeEn   String?
  duration    Int     // minutes
  intensity   String  // low | medium | high | extreme
  maxSpots    Int     @default(15)
  price       Float   @default(0)
  image       String?
  showTrainerName Boolean @default(true)
  isActive    Boolean @default(true)

  trainer   Trainer    @relation(fields: [trainerId], references: [id])
  schedules Schedule[]
}

model Schedule {
  id             String   @id @default(cuid())
  classId        String
  date           DateTime
  time           String   // "06:00"
  availableSpots Int
  isActive       Boolean  @default(true)

  class    Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  bookings Booking[]
}

// ─── Booking ──────────────────────────────────────────────────────────────────

model Booking {
  id            String    @id @default(cuid())
  userId        String
  scheduleId    String
  userMembershipId String?
  status        String    @default("confirmed") // confirmed | cancelled | attended | noshow
  paidAmount    Float     @default(0)
  paymentMethod String    @default("wallet") // wallet | card | cash
  reminderSentAt DateTime?
  createdAt     DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  userMembership UserMembership? @relation(fields: [userMembershipId], references: [id], onDelete: SetNull)
  attendanceCheckIn AttendanceCheckIn?

  @@index([userMembershipId])
}

// ─── Product & Order ──────────────────────────────────────────────────────────

model Product {
  id          String  @id @default(cuid())
  name        String
  nameEn      String?
  description String? @db.Text
  descriptionEn String? @db.Text
  price       Float
  oldPrice    Float?
  category    String
  stock       Int     @default(0)
  sku         String? @unique
  barcode     String?
  unitLabel   String?
  trackInventory   Boolean @default(true)
  averageCost      Float   @default(0)
  lastPurchaseCost Float   @default(0)
  costPrice        Float?  // buying/purchase price — admin only, never sent to client
  reorderLevel     Int     @default(0)
  images      String? @db.Text // JSON array of URLs
  sizes       String? @db.Text // JSON array (legacy, kept for compatibility)
  colors      String? @db.Text // JSON array (legacy, kept for compatibility)
  faqs            String? @db.Text // JSON: [{q,a}]
  whoShouldBuy    String? @db.Text // JSON: [{title,desc,suitable}]
  importantInfo   String? @db.Text
  disclaimer      String? @db.Text
  editorialReview String? @db.Text
  isActive        Boolean @default(true)
  isFeatured      Boolean @default(false)
  isNew           Boolean @default(false)
  isBestSeller    Boolean @default(false)
  isSpecialOffer  Boolean @default(false)
  vatEnabled      Boolean @default(false)
  // Supplier (admin-only — never exposed to customers)
  supplierId      String?
  deletedAt       DateTime? // soft delete
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt @default(now())

  supplier     Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  orderItems   OrderItem[]
  reviews      ProductReview[]
  variants     ProductVariant[]
  stockMovements      InventoryMovement[]    @relation("InventoryProduct")
  receiptItems        InventoryReceiptItem[] @relation("InventoryReceiptProduct")

  @@index([supplierId])
  @@index([category, isActive])
  @@index([deletedAt])
}

model ProductReview {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
}

model Order {
  id            String   @id @default(cuid())
  userId        String
  businessUnit  String   @default("store") // store | club
  subtotal      Float    @default(0)
  discountTotal Float    @default(0)
  shippingFee   Float    @default(0)
  total         Float
  // pending | confirmed | preparing | ready_to_ship | shipped_to_courier | in_transit | delivered | cancelled | returned
  status        String   @default("pending")
  deliveryOptionId String?
  deliveryLabel String?
  estimatedDeliveryDays Int?
  isClubPickup  Boolean  @default(false)
  recipientName String?
  recipientPhone String?
  governorate   String?  // Egyptian governorate
  city          String?
  address       String?
  notes         String?  @db.Text
  adminNotes    String?  @db.Text // internal — never sent to customer
  paymentMethod String   @default("card")
  // Delivery company link (replaces simple deliveryOption for full tracking)
  deliveryCompanyId String?
  trackingNumber    String?
  inventoryDeducted Boolean  @default(false) // guard: stock deducted once only
  cancelledAt   DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryOption DeliveryOption? @relation(fields: [deliveryOptionId], references: [id], onDelete: SetNull)
  deliveryCompany DeliveryCompany? @relation("OrderDeliveryCompany", fields: [deliveryCompanyId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  paymentTransactions PaymentTransaction[]
  statusHistory  OrderStatusHistory[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([deliveryCompanyId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  variantId String? // FK to ProductVariant if applicable
  quantity  Int
  price     Float
  costPrice Float?  // snapshot of cost at time of order (admin only)
  vatAmount Float   @default(0)
  size      String?
  color     String?

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model PaymentTransaction {
  id                String    @id @default(cuid())
  userId            String
  orderId           String?
  membershipId      String?
  offerId           String?
  referenceCode     String?   @unique
  purpose           String    // order | membership | wallet_topup
  businessUnit      String    @default("store") // store | club
  provider          String    // manual | paymob | paytabs | custom
  providerReference String?   @unique
  externalReference String?   @unique
  amount            Float
  currency          String    @default("EGP")
  status            String    @default("pending") // pending | requires_action | paid | failed | cancelled | expired
  paymentMethod     String    @default("card")
  checkoutUrl       String?   @db.Text
  iframeUrl         String?   @db.Text
  returnUrl         String?   @db.Text
  cancelUrl         String?   @db.Text
  providerPayload   String?   @db.LongText
  metadata          String?   @db.LongText
  expiresAt         DateTime?
  paidAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([orderId])
  @@index([provider, status])
}

model PaymentReferenceCounter {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ─── Wallet ───────────────────────────────────────────────────────────────────

model Wallet {
  id      String @id @default(cuid())
  userId  String @unique
  balance Float  @default(0)

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String   @id @default(cuid())
  walletId    String
  amount      Float
  type        String   // credit | debit
  description String?
  createdAt   DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

// ─── Rewards ──────────────────────────────────────────────────────────────────

model RewardPoints {
  id      String @id @default(cuid())
  userId  String @unique
  points  Int    @default(0)
  tier    String @default("bronze") // bronze | silver | gold | platinum

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  history RewardHistory[]
}

model RewardHistory {
  id        String   @id @default(cuid())
  rewardId  String
  points    Int
  reason    String
  createdAt DateTime @default(now())

  reward RewardPoints @relation(fields: [rewardId], references: [id], onDelete: Cascade)
}

// ─── Referral ─────────────────────────────────────────────────────────────────

model Referral {
  id                       String @id @default(cuid())
  userId                   String @unique
  code                     String @unique
  totalEarned              Float  @default(0)
  referredCount            Int    @default(0)
  subscriptionActivatedCount Int  @default(0)

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  usages ReferralUsage[]
}

model ReferralUsage {
  id                      String    @id @default(cuid())
  referralId              String
  referredUserId          String    @unique
  rewardGiven             Boolean   @default(false)
  rewardType              String?   // points | wallet
  rewardValue             Float?
  subscriptionActivated   Boolean   @default(false)
  subscriptionActivatedAt DateTime?
  createdAt               DateTime  @default(now())

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
}

// ─── Discount Code ─────────────────────────────────────────────────────────────

model DiscountCode {
  id            String   @id @default(cuid())
  code          String   @unique
  description   String?
  descriptionEn String?
  type          String   @default("percentage") // percentage | fixed
  value         Float
  minAmount     Float?
  maxUses       Int?
  usedCount     Int      @default(0)
  scope         String   @default("all") // subscriptions | store | all
  expiresAt     DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  usages DiscountCodeUsage[]
}

model DiscountCodeUsage {
  id             String   @id @default(cuid())
  discountCodeId String
  userId         String
  membershipId   String?
  discountAmount Float
  createdAt      DateTime @default(now())

  discountCode DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
}

// ─── Notification ─────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String   @default("info") // info | success | warning | error
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Offer ────────────────────────────────────────────────────────────────────

model Offer {
  id                 String      @id @default(cuid())
  title              String
  titleEn            String?
  type               String      @default("percentage") // percentage | fixed | special
  discount           Float
  description        String?     @db.Text
  descriptionEn      String?     @db.Text
  appliesTo          String? @db.Text
  appliesToEn        String? @db.Text
  expiresAt          DateTime
  isActive           Boolean     @default(true)
  membershipId       String?
  specialPrice       Float?
  maxSubscribers     Int?
  currentSubscribers Int         @default(0)
  image              String?
  showOnHome              Boolean     @default(false)
  showMaxSubscribers      Boolean     @default(true)
  showCurrentSubscribers  Boolean     @default(true)
  sessionsCount           Int?
  durationDays            Int?

  membership Membership? @relation(fields: [membershipId], references: [id])
  userMemberships UserMembership[]
}

model ProductCategory {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  labelEn   String?
  sizeType  String   @default("none") // none | clothing | shoes
  icon      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClubGoal {
  id          String   @id @default(cuid())
  name        String
  nameEn      String?
  slug        String   @unique
  description String?  @db.Text
  descriptionEn String? @db.Text
  image       String?
  kind        String   @default("standard") // standard | games_root | games_adults | games_children
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent      ClubGoal?         @relation("GoalHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    ClubGoal[]        @relation("GoalHierarchy")
  classRules  GoalClassRule[]
  membershipGoals MembershipGoal[]
}

model MembershipGoal {
  id           String   @id @default(cuid())
  membershipId String
  goalId       String
  createdAt    DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  goal       ClubGoal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([membershipId, goalId])
  @@index([goalId])
}

model HealthQuestion {
  id           String   @id @default(cuid())
  title        String
  titleEn      String?
  slug         String   @unique
  prompt       String
  promptEn     String?  @db.Text
  isActive     Boolean  @default(true)
  allowReason  Boolean  @default(false) // show reason text field when client answers Yes
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restrictions HealthQuestionRestriction[]
  responses    HealthResponse[]
}

model HealthResponse {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  answer     Boolean  // true = yes, false = no
  reason     String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User           @relation("HealthResponses", fields: [userId], references: [id], onDelete: Cascade)
  question HealthQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
}

model HealthQuestionRestriction {
  id         String   @id @default(cuid())
  questionId String
  classType  String
  notes      String?  @db.Text
  createdAt  DateTime @default(now())

  question HealthQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, classType])
}

model GoalClassRule {
  id         String   @id @default(cuid())
  goalId     String
  classType  String
  rule       String   @default("recommended") // recommended | blocked | optional
  notes      String?  @db.Text
  createdAt  DateTime @default(now())

  goal ClubGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, classType, rule])
}


model DeliveryOption {
  id                 String   @id @default(cuid())
  name               String
  nameEn             String?
  type               String   @default("courier") // courier | pickup
  description        String?  @db.Text
  descriptionEn      String?  @db.Text
  fee                Float    @default(0)
  estimatedDaysMin   Int?
  estimatedDaysMax   Int?
  isActive           Boolean  @default(true)
  showCashOnDelivery Boolean  @default(false)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orders Order[]
}

model InventoryReceipt {
  id              String   @id @default(cuid())
  referenceNumber String?  @unique
  invoiceNumber   String?  // supplier's invoice number
  invoiceDate     DateTime? // date on the supplier's invoice
  supplierId      String?  // FK to Supplier model (replaces free-text supplierName)
  supplierName    String?  // kept for legacy / manual entry
  notes           String?  @db.Text
  receivedAt      DateTime @default(now())
  status          String   @default("posted") // draft | posted | cancelled
  totalCost       Float    @default(0)
  performedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier    Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  performedBy User?                  @relation("InventoryReceiptPerformer", fields: [performedByUserId], references: [id], onDelete: SetNull)
  items       InventoryReceiptItem[]

  @@index([supplierId])
  @@index([status, createdAt])
}

model InventoryReceiptItem {
  id         String   @id @default(cuid())
  receiptId  String
  productId  String
  variantId  String?  // FK to ProductVariant if applicable
  quantity   Int
  unitCost   Float
  totalCost  Float
  sellingPrice Float? // suggested selling price at time of purchase
  sku        String?  // snapshot of SKU
  notes      String?  @db.Text
  createdAt  DateTime @default(now())

  receipt InventoryReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product          @relation("InventoryReceiptProduct", fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant?  @relation("ReceiptItemVariant", fields: [variantId], references: [id], onDelete: SetNull)

  @@index([receiptId])
  @@index([productId])
}

model InventoryMovement {
  id                String   @id @default(cuid())
  productId         String
  variantId         String?  // FK to ProductVariant (optional)
  // purchase | sale | adjustment | return | damage | order_deduction | order_restore
  type              String
  quantityChange    Int      // positive = in, negative = out
  quantityBefore    Int
  quantityAfter     Int
  unitCost          Float?
  averageCostBefore Float?
  averageCostAfter  Float?
  referenceType     String?  // Order | InventoryReceipt | manual
  referenceId       String?
  reason            String?  @db.Text // mandatory for adjustment/damage
  performedByUserId String?
  notes             String?  @db.Text
  createdAt         DateTime @default(now())

  product     Product         @relation("InventoryProduct", fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation("VariantMovement", fields: [variantId], references: [id], onDelete: SetNull)
  performedBy User?           @relation("InventoryMovementPerformer", fields: [performedByUserId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([variantId, createdAt])
  @@index([type, createdAt])
}

// ─── Complaint ────────────────────────────────────────────────────────────────

model AccountingExpense {
  id              String   @id @default(cuid())
  businessUnit    String   @default("store") // store | club
  category        String   @default("general")
  label           String
  description     String?  @db.Text
  amount          Float
  vendor          String?
  referenceNumber String?
  expenseDate     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([businessUnit, expenseDate])
  @@index([category, expenseDate])
}

model AccountingFeeRule {
  id               String   @id @default(cuid())
  businessUnit     String   @default("both") // store | club | both
  category         String   @default("platform") // platform | external_service | other
  label            String
  appliesToPurpose String   @default("all") // all | order | membership | wallet_topup | booking
  provider         String?
  paymentMethod    String?
  rateType         String   @default("percentage") // percentage | fixed
  rateValue        Float
  notes            String?  @db.Text
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([businessUnit, isActive])
}

model Complaint {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  message   String
  status    String   @default("open") // open | in-progress | resolved | closed
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id                    String   @id @default(cuid())
  visitorName           String?
  visitorPhone          String?
  status                String   @default("open") // open | live | resolved
  mode                  String   @default("bot") // bot | live
  context               String?  @db.LongText // JSON string for questionnaire state
  assignedToId          String?
  recommendedMembershipId String?
  lastMessageAt         DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  assignedTo            User?       @relation("AssignedSupport", fields: [assignedToId], references: [id])
  recommendedMembership Membership? @relation(fields: [recommendedMembershipId], references: [id])
  messages              ChatMessage[]
}

model ChatMessage {
  id         String   @id @default(cuid())
  sessionId  String
  senderType String   // user | bot | admin | staff | system
  senderName String?
  content    String   @db.Text
  metadata   String?  @db.LongText
  createdAt  DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SupportPresence {
  id         String   @id @default(cuid())
  userId     String   @unique
  isOnline   Boolean  @default(false)
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Web Push ─────────────────────────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String?
  endpoint  String   @unique @db.VarChar(512)
  p256dh    String   @db.Text
  auth      String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model PushCampaign {
  id            String   @id @default(cuid())
  title         String
  body          String   @db.Text
  url           String?
  audience      String   @default("all")   // all | active | inactive | selected
  selectedUsers String?  @db.LongText      // JSON array of user IDs
  sentCount     Int      @default(0)
  failedCount   Int      @default(0)
  status        String   @default("done")  // done | partial | failed
  createdAt     DateTime @default(now())
  createdBy     String?

  admin User? @relation("CampaignAdmin", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// ─── SiteContent ──────────────────────────────────────────────────────────────

model SiteContent {
  id        String   @id @default(cuid())
  section   String   @unique // hero | contact | trainers | blog | announcements | about
  content   String   @db.LongText // JSON string
  updatedAt DateTime @updatedAt
}

model ChatKnowledgeEntry {
  id        String   @id @default(cuid())
  title     String
  category  String   @default("general")
  keywords  String
  answer    String
  priority  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── AI Coach ─────────────────────────────────────────────────────────────────

model CoachProfile {
  id                  String    @id @default(cuid())
  userId              String?   @unique
  guestSessionId      String?   @unique
  primaryGoal         String?   // weight-loss | muscle-gain | toning | general-fitness
  trainingLevel       String?   // beginner | intermediate | advanced
  preferredDays       Int?      // weekly sessions preference
  preferredClassTypes String? @db.Text  // JSON array of class type strings
  injuries            String?   @db.Text
  nutritionStyle      String?   // poor | average | good
  targetWeight        Float?
  currentWeight       Float?
  height              Float?
  age                 Int?
  notes               String?   @db.Text
  lastAssessmentAt    DateTime?
  lastCheckInAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIns  CoachCheckIn[]
}

model CoachCheckIn {
  id             String   @id @default(cuid())
  coachProfileId String
  weight         Float?
  waist          Float?
  energyLevel    Int?     // 1-5 scale
  adherenceScore Int?     // 0-100 (% of planned sessions completed)
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  coachProfile CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
}

model CoachEventLog {
  id        String   @id @default(cuid())
  sessionId String
  intent    String
  usedAI    Boolean  @default(false)
  handoff   Boolean  @default(false)
  outcome   String?  // food_check | class_suggested | membership_recommended | check_in | handoff | unknown
  createdAt DateTime @default(now())
}

model QuickReply {
  id        String   @id @default(cuid())
  label     String   // short label shown as button
  content   String   @db.Text // full reply text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id          String   @id @default(cuid())
  userId      String
  displayName String?
  displayNameEn String?
  content     String
  contentEn   String?  @db.Text
  rating      Int      @default(5)
  status      String   @default("pending") // pending | approved | rejected
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Trainer Discount Codes ────────────────────────────────────────────────────

model TrainerDiscountCode {
  id            String    @id @default(cuid())
  trainerId     String
  code          String    @unique
  targetUserId  String
  discountType  String    @default("percentage") // percentage | fixed
  discountValue Float
  maxDiscount   Float?    // cap in EGP for percentage type
  note          String?
  isUsed        Boolean   @default(false)
  usedAt        DateTime?
  monthYear     String    // "2026-04" — for monthly limit (4/month per trainer)
  createdAt     DateTime  @default(now())

  trainer    Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  targetUser User    @relation("TrainerCodeTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([trainerId, monthYear])
  @@index([code])
}

model StaffDiscountCode {
  id            String    @id @default(cuid())
  staffUserId   String
  code          String    @unique
  targetUserId  String
  discountType  String    @default("percentage") // percentage | fixed
  discountValue Float
  maxDiscount   Float?
  note          String?
  isUsed        Boolean   @default(false)
  usedAt        DateTime?
  monthYear     String
  createdAt     DateTime  @default(now())

  staff      User @relation("StaffCodeIssuer", fields: [staffUserId], references: [id], onDelete: Cascade)
  targetUser User @relation("StaffCodeTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId, monthYear])
  @@index([code])
}

// ─── Private Session Applications ─────────────────────────────────────────────

model PrivateSessionApplication {
  id          String    @id @default(cuid())
  userId      String
  trainerId   String
  type        String    @default("private") // private | mini_private
  status      String    @default("pending") // pending | approved | rejected | paid | cancelled

  // Application form
  goalsJson           String?  @db.Text      // JSON array of goals
  injuries            String?  @db.Text
  availability        String?  @db.Text      // JSON
  notes               String?  @db.Text
  applicationFormJson String?  @db.LongText  // Full 11-section application JSON

  // Trainer response
  trainerNote  String?  @db.Text
  trainerPrice Float?

  // Session terms (set at approval)
  sessionsCount Int?
  durationDays  Int?

  // Scheduling (set at approval; client selects one)
  trainerSlots String?  @db.Text  // JSON: ["الأحد 10 صباحاً", "الاثنين 6 مساءً"]
  selectedSlot String?            // Client-chosen slot text

  // Payment
  paymentTransactionId String?
  paidAt               DateTime?
  expiresAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation("PrivateApplicationUser", fields: [userId], references: [id], onDelete: Cascade)
  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  attendancePass AttendancePass?
  attendanceCheckIns AttendanceCheckIn[]

  @@index([userId])
  @@index([trainerId])
}

// ─── Partner / Affiliate System ───────────────────────────────────────────────

model Partner {
  id               String   @id @default(cuid())
  userId           String   @unique
  name             String
  nameEn           String?
  category         String   // beauty_center | salon | pharmacy | clinic | physiotherapy | nutrition | nursery | education | clothing | other | spa | restaurant | sports | supplement | services
  logoUrl          String?
  websiteUrl       String?
  contactPhone     String?
  commissionRate   Float    @default(10)   // percentage or fixed EGP amount
  commissionType   String   @default("percentage") // percentage | fixed
  contractStartDate DateTime?
  contractEndDate   DateTime?
  referralDiscountRate Float?   // % gym discount client gets when signing up via partner referral link
  memberBenefitCode String?  @unique // code gym members show at partner's location to get partner discount
  memberBenefitRate Float?   // % discount at partner's business for active gym members
  isActive         Boolean  @default(true)
  showOnPublicPage Boolean  @default(true)
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  managerId             String?  // ContractsManager.id who manages this partner
  managerCommissionType String?  // "percentage_of_partner" | "fixed"
  managerCommissionRate Float?

  user               User                       @relation("PartnerAccount", fields: [userId], references: [id], onDelete: Cascade)
  codes              PartnerCode[]
  affiliateLinks     PartnerAffiliateLink[]
  commissions        PartnerCommission[]
  userMemberships    UserMembership[]
  withdrawalRequests PartnerWithdrawalRequest[]
  manager            ContractsManager?          @relation("ManagedPartners", fields: [managerId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([managerId])
}

model PartnerCode {
  id            String    @id @default(cuid())
  partnerId     String
  code          String    @unique
  discountType  String    @default("percentage") // percentage | fixed
  discountValue Float
  maxUsage      Int?      // null = unlimited
  usageCount    Int       @default(0)
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  partner         Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  userMemberships UserMembership[]

  @@index([partnerId])
  @@index([code])
}

model PartnerAffiliateLink {
  id           String   @id @default(cuid())
  partnerId    String
  token        String   @unique // short slug used in ?ref=TOKEN
  label        String?
  clickCount   Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  partner         Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  userMemberships UserMembership[]

  @@index([partnerId])
  @@index([token])
}

model PartnerCommission {
  id               String    @id @default(cuid())
  partnerId        String
  userMembershipId String    @unique
  amount           Float
  status           String    @default("pending") // pending | withdrawn
  withdrawnAt      DateTime?
  notes            String?
  createdAt        DateTime  @default(now())

  partner        Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  userMembership UserMembership @relation(fields: [userMembershipId], references: [id], onDelete: Cascade)
  managerCommission ManagerPartnerCommission?

  @@index([partnerId, status])
  @@index([createdAt])
}

model AgentCommission {
  id               String    @id @default(cuid())
  agentUserId      String
  userMembershipId String    @unique
  amount           Float
  status           String    @default("earned") // earned | settled
  settledAt        DateTime?
  createdAt        DateTime  @default(now())

  agentUser      User           @relation("AgentCommissionUser", fields: [agentUserId], references: [id], onDelete: Cascade)
  userMembership UserMembership @relation(fields: [userMembershipId], references: [id], onDelete: Cascade)

  @@index([agentUserId, status])
  @@index([createdAt])
}

model PartnerWithdrawalRequest {
  id          String    @id @default(cuid())
  partnerId   String
  amount      Float
  status      String    @default("pending") // pending | approved | rejected
  adminNotes  String?
  receiptUrl  String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([status])
  @@index([createdAt])
}

// ─── Sales Agent / Contracts System ──────────────────────────────────────────

model SalesAgent {
  id                  String   @id @default(cuid())
  userId              String   @unique
  name                String
  referralCode        String   @unique  // short code e.g. "FZ-ABCD1234"
  commissionRate      Float    @default(0)
  commissionType      String   @default("percentage") // percentage | fixed
  clientDiscountType  String   @default("percentage") // discount client gets on subscription
  clientDiscountValue Float    @default(0)
  maxClientDiscount   Float?
  isActive            Boolean  @default(true)
  managerId           String?  // ContractsManager.id who created/manages this agent
  notes               String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  manager      ContractsManager?      @relation("ManagedAgents", fields: [managerId], references: [id], onDelete: SetNull)
  commissions  SalesAgentCommission[]
  referrals    SalesAgentReferral[]
  memberships  UserMembership[]

  @@index([referralCode])
  @@index([userId])
  @@index([managerId])
}

model SalesAgentReferral {
  id          String     @id @default(cuid())
  agentId     String
  userId      String     @unique  // the referred user (one user can only be referred once)
  convertedAt DateTime?           // when they first subscribed
  totalSpent  Float      @default(0)
  createdAt   DateTime   @default(now())

  agent SalesAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

model SalesAgentCommission {
  id               String     @id @default(cuid())
  agentId          String
  userMembershipId String     @unique
  amount           Float
  status           String     @default("earned") // earned | settled
  settledAt        DateTime?
  createdAt        DateTime   @default(now())

  agent             SalesAgent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  userMembership    UserMembership    @relation(fields: [userMembershipId], references: [id], onDelete: Cascade)
  managerCommission ManagerCommission?

  @@index([agentId, status])
  @@index([createdAt])
}

// ─── Contracts Manager System ─────────────────────────────────────────────────

model ContractsManager {
  id             String   @id @default(cuid())
  userId         String   @unique
  name           String
  commissionType String   @default("percentage_of_agents") // percentage_of_agents | percentage_of_revenue | fixed
  commissionRate Float    @default(0)
  isActive       Boolean  @default(true)
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  agents      SalesAgent[]        @relation("ManagedAgents")
  commissions ManagerCommission[]
  managedPartners    Partner[]                  @relation("ManagedPartners")
  partnerCommissions ManagerPartnerCommission[]

  @@index([userId])
}

model ManagerCommission {
  id                String    @id @default(cuid())
  managerId         String
  agentCommissionId String?   @unique   // linked to SalesAgentCommission when type=percentage_of_agents
  userMembershipId  String?             // soft ref to UserMembership
  amount            Float
  status            String    @default("earned") // earned | settled
  settledAt         DateTime?
  createdAt         DateTime  @default(now())

  manager         ContractsManager      @relation(fields: [managerId], references: [id], onDelete: Cascade)
  agentCommission SalesAgentCommission? @relation(fields: [agentCommissionId], references: [id], onDelete: SetNull)

  @@index([managerId, status])
  @@index([createdAt])
}

// ─── Staff Referral Links ─────────────────────────────────────────────────────

model StaffReferralLink {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  label      String?
  clickCount Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  user        User              @relation("StaffLinks", fields: [userId], references: [id], onDelete: Cascade)
  memberships UserMembership[]
  commissions StaffCommission[]

  @@index([userId])
}

model StaffCommission {
  id                  String    @id @default(cuid())
  staffUserId         String
  staffReferralLinkId String?
  userMembershipId    String?   @unique
  amount              Float
  status              String    @default("earned") // earned | settled
  settledAt           DateTime?
  createdAt           DateTime  @default(now())

  staffUser         User               @relation("StaffCommissions", fields: [staffUserId], references: [id], onDelete: Cascade)
  staffReferralLink StaffReferralLink?  @relation(fields: [staffReferralLinkId], references: [id], onDelete: SetNull)
  userMembership    UserMembership?     @relation(fields: [userMembershipId], references: [id], onDelete: SetNull)

  @@index([staffUserId, status])
  @@index([createdAt])
}

// ─── Trainer Referral Links & Commissions ─────────────────────────────────────

model TrainerReferralLink {
  id         String   @id @default(cuid())
  userId     String   // trainer's user ID
  token      String   @unique
  label      String?
  clickCount Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  user        User               @relation("TrainerLinks", fields: [userId], references: [id], onDelete: Cascade)
  memberships UserMembership[]
  commissions TrainerCommission[]

  @@index([userId])
}

model TrainerCommission {
  id                    String    @id @default(cuid())
  trainerUserId         String
  trainerReferralLinkId String?
  userMembershipId      String?   @unique
  amount                Float
  status                String    @default("earned") // earned | settled
  settledAt             DateTime?
  createdAt             DateTime  @default(now())

  trainerUser         User                @relation("TrainerCommissions", fields: [trainerUserId], references: [id], onDelete: Cascade)
  trainerReferralLink TrainerReferralLink? @relation(fields: [trainerReferralLinkId], references: [id], onDelete: SetNull)
  userMembership      UserMembership?     @relation(fields: [userMembershipId], references: [id], onDelete: SetNull)

  @@index([trainerUserId, status])
  @@index([createdAt])
}

// ─── Nutrition Doctor ─────────────────────────────────────────────────────────

model NutritionistProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  bio       String?  @db.Text
  image     String?
  isActive  Boolean  @default(true)
  showOnHome Boolean @default(true)

  // Pre-set available slots (JSON: [{label:"الأحد 10 صباحاً", day:"الأحد", time:"10:00"}])
  slotsJson String?  @db.Text

  // Pricing (editable by admin)
  consultationFee       Float @default(400) // كشف - non-member
  consultationFeeMember Float @default(300) // كشف - gym member
  followupFee           Float @default(100) // إعادة كشف - non-member
  followupFeeMember     Float @default(50)  // إعادة كشف - gym member

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User               @relation("NutritionistAccount", fields: [userId], references: [id], onDelete: Cascade)
  sessions NutritionSession[]

  @@index([isActive])
}

model NutritionSession {
  id             String  @id @default(cuid())
  userId         String
  nutritionistId String
  // consultation | followup
  type           String  @default("consultation")
  // pending | awaiting_slot | approved | paid | completed | rejected | cancelled
  status         String  @default("pending")

  isGymMember Boolean @default(false)
  price       Float

  // Full form data (JSON)
  formJson String? @db.LongText

  // Scheduling
  // Flow A: client picks from doctor's pre-set slots on submission
  // Flow B: doctor proposes slots after reviewing the request → client picks
  selectedSlot  String?          // client-chosen slot label
  proposedSlots String? @db.Text // JSON array: doctor proposes after review

  // Doctor response
  doctorNote String? @db.Text

  // Payment
  paymentTransactionId String?
  paidAt               DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation("NutritionSessionUser", fields: [userId], references: [id], onDelete: Cascade)
  nutritionist NutritionistProfile @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([nutritionistId])
  @@index([status])
}

// ─── Supplier (Vendor) — admin-only, never exposed to customers ───────────────

model Supplier {
  id             String    @id @default(cuid())
  name           String    // internal name — never shown to customers
  phone          String?
  address        String?   @db.Text
  notes          String?   @db.Text
  isActive       Boolean   @default(true)
  commissionRate Float?    // optional: profit margin / commission rate
  commissionType String?   // percentage | fixed
  deletedAt      DateTime? // soft delete
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  products  Product[]
  receipts  InventoryReceipt[]

  @@index([isActive])
  @@index([deletedAt])
}

// ─── Product Variants ─────────────────────────────────────────────────────────

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  size      String?
  color     String?
  sku       String?  @unique
  barcode   String?
  stock     Int      @default(0)
  price     Float?   // override product base price (null = use product price)
  costPrice Float?   // buying cost for this specific variant
  image     String?  // variant-specific image URL
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]
  receiptItems InventoryReceiptItem[] @relation("ReceiptItemVariant")
  movements    InventoryMovement[]    @relation("VariantMovement")

  @@index([productId, isActive])
  @@index([sku])
}

// ─── Order Status History (Timeline) ─────────────────────────────────────────

model OrderStatusHistory {
  id                String   @id @default(cuid())
  orderId           String
  fromStatus        String?  // null on first entry
  toStatus          String
  notes             String?  @db.Text
  performedByUserId String?
  createdAt         DateTime @default(now())

  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  performedBy User? @relation("OrderStatusPerformer", fields: [performedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

// ─── Delivery Companies ───────────────────────────────────────────────────────

model DeliveryCompany {
  id              String    @id @default(cuid())
  name            String
  // courier | pickup | internal_courier
  type            String    @default("courier")
  phone           String?
  contactPerson   String?
  defaultFee      Float     @default(0)
  estimatedDays   String?   // e.g. "2-3 أيام عمل"
  supportsCOD     Boolean   @default(true)
  codFeeType      String?   // percentage | fixed | null (no extra fee)
  codFeeValue     Float?
  collectsPayment Boolean   @default(true) // does company collect cash from customer?
  isActive        Boolean   @default(true)
  notes           String?   @db.Text
  deletedAt       DateTime? // soft delete
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  zones  DeliveryZone[]
  orders Order[]        @relation("OrderDeliveryCompany")

  @@index([isActive])
}

// ─── Delivery Zones (price per governorate) ───────────────────────────────────

model DeliveryZone {
  id            String   @id @default(cuid())
  companyId     String
  governorate   String   // e.g. "القاهرة", "الجيزة", "الإسكندرية"
  fee           Float
  estimatedDays String?  // overrides company default for this zone
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company DeliveryCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, governorate])
  @@index([companyId, isActive])
}

// ─── Manager–Partner Commission ───────────────────────────────────────────────

model ManagerPartnerCommission {
  id                  String    @id @default(cuid())
  managerId           String
  partnerCommissionId String?   @unique
  userMembershipId    String?
  amount              Float
  status              String    @default("earned") // earned | settled
  settledAt           DateTime?
  createdAt           DateTime  @default(now())

  manager           ContractsManager   @relation(fields: [managerId], references: [id], onDelete: Cascade)
  partnerCommission PartnerCommission? @relation(fields: [partnerCommissionId], references: [id], onDelete: SetNull)

  @@index([managerId, status])
  @@index([createdAt])
}
